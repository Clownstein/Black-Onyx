{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-onyx.local/schemas/model_serving_report.json",
  "title": "ModelServingReport",
  "description": "POST /api/v1/serving/{model}/report: what one model replica actually serves.",
  "type": "object",
  "required": [
    "instance_id"
  ],
  "additionalProperties": false,
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "champion",
          "canary",
          "shadow"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "signature",
          "generation"
        ],
        "properties": {
          "version": {
            "type": ["string", "null"]
          },
          "signature": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "loaded_at": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "champion",
          "canary",
          "shadow"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      }
    }
  }
}
