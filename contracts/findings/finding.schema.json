{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-onyx.local/schemas/finding.json",
  "title": "Finding",
  "description": "Unified model finding (ANOMALY_DETECTION_PLATFORM.md §10.2).",
  "type": "object",
  "required": [
    "schema_version",
    "finding_id",
    "tenant_id",
    "finding_type",
    "asset_id",
    "model_name",
    "model_version",
    "raw_score",
    "calibrated_score",
    "window"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "finding_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "finding_type": { "type": "string", "minLength": 1 },
    "asset_id": { "type": "string", "minLength": 1 },
    "service_id": { "type": ["string", "null"] },
    "model_name": { "type": "string" },
    "model_version": { "type": "string" },
    "feature_version": { "type": ["string", "null"] },
    "raw_score": { "type": "number" },
    "calibrated_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity_hint": {
      "type": ["string", "null"],
      "enum": ["low", "medium", "high", "critical", null]
    },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "contributors": { "type": "array", "items": { "type": "object" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "context": { "type": "object" },
    "fingerprint": { "type": ["string", "null"] },
    "category": { "type": "array", "items": { "type": "string" } },
    "mitre_tactics": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TA[0-9]{4}$" }
    },
    "mitre_techniques": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
    },
    "mitre_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "threat_intel": {
      "type": "object",
      "properties": {
        "matched_indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string" },
              "value": { "type": "string" },
              "confidence": { "type": "integer" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "campaigns": { "type": "array", "items": { "type": "string" } },
        "tlp": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "compliance": {
      "type": "object",
      "description": "Optional security-profile enrichment (packs/checks).",
      "properties": {
        "profile_pack_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "check_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["network", "host", "webapp", "identity", "cloud", "code"]
          }
        },
        "automation": {
          "type": ["string", "null"],
          "enum": ["auto", "manual", "hybrid", null]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
