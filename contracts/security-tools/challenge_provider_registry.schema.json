{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackonyx.local/contracts/security-tools/challenge-provider-registry.schema.json",
  "title": "Security challenge provider registry",
  "description": "Operator-owned challenge IDs mapped to fixed HTTPS or private-service endpoints and exact IPv4 addresses. Requesters never choose URLs.",
  "type": "object",
  "maxProperties": 64,
  "patternProperties": {
    "^[a-z0-9][a-z0-9_.-]{0,63}$": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_url", "submit_url", "allowed_ips"],
      "properties": {
        "status_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "submit_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "allowed_ips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "format": "ipv4"}
        }
      }
    }
  },
  "additionalProperties": false
}
