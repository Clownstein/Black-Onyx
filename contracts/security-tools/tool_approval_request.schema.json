{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-onyx.local/schemas/tool_approval_request.json",
  "title": "ToolApprovalRequest",
  "description": "POST /v1/tools/{tool}/approve: the previewed request plus its preview_hash; requester only for administrator (second-person) approvals.",
  "type": "object",
  "required": [
    "preview_hash"
  ],
  "properties": {
    "arguments": {
      "type": "object"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "network_profile": {
      "enum": ["offline", "public", "lab"]
    },
    "destinations": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 253}
    },
    "ports": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 65535}
    },
    "lab_profile_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "resolved_targets": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {"type": "string", "format": "ipv4"}
      }
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requester": {
      "type": "string",
      "maxLength": 256
    }
  }
}
