# Required authentication / encryption secret (keep stable across restarts).
# BLACK_ONYX_AUTH_SECRET=
# Platform Postgres (auth + tip schemas). Required when QDRANT_SECURITY__PRODUCTION=true.
# BLACK_ONYX_DATABASE_URL=postgresql+psycopg://anomaly:<postgres-password>@postgres:5432/black_onyx
# Security gateway durable state (approvals + challenge solves).
# SECURITY_GATEWAY_DATABASE_URL=postgresql+psycopg://anomaly:<postgres-password>@postgres:5432/security_gateway
# Required detection-plane tenant bound into BFF-minted JWTs and service calls.
# BLACK_ONYX_DETECTION_TENANT=
# Optional host publish port override for docker-compose / Vite proxy.
# BLACK_ONYX_PORT=8000

# MCP tools (black-onyx-tools): shared service key + audit actor (admin/analyst UUID).
# Fail-closed when unset. Demo-shaped keys require ALLOW_DEMO_KEYS=true.
# BLACK_ONYX_MCP_SERVICE_KEY=
# BLACK_ONYX_MCP_ACTOR_USER_ID=
# BLACK_ONYX_DEFAULT_TENANT_ID=

# Response-orchestrator S2S key, shared by the TIP BFF, orchestrator and
# integration hub.
# RESPONSE_ORCHESTRATOR_API_KEY=
# Separate elevated secret required to switch an approved request to live mode.
# RESPONSE_ORCHESTRATOR_APPROVER_API_KEY=
# Host isolation. Leave the provider empty to keep the generic EDR path.
# Set the provider to wazuh and supply the Wazuh API values so an approved
# isolate-host request reaches the manager. Both the response orchestrator
# and integration hub read these names from Compose.
# RESPONSE_ORCHESTRATOR_EDR_PROVIDER=
# RESPONSE_ORCHESTRATOR_WAZUH_API_URL=
# RESPONSE_ORCHESTRATOR_WAZUH_API_USER=
# RESPONSE_ORCHESTRATOR_WAZUH_API_PASSWORD=
# RESPONSE_ORCHESTRATOR_WAZUH_API_CA_FILE=
# RESPONSE_ORCHESTRATOR_WAZUH_API_VERIFY_TLS=true
# RESPONSE_ORCHESTRATOR_WAZUH_ISOLATION_ALLOW=

# Detection service-to-service credentials. These have no built-in defaults;
# services stay not-ready and protected routes fail closed until configured.
# INCIDENT_API_SERVICE_KEY=
# ASSET_REGISTRY_SERVICE_KEY=
# THREAT_INTEL_SERVICE_API_KEY=
# INTEGRATION_HUB_API_KEY=
# MALWARE_SERVICE_API_KEY=
# NOTIFICATION_API_KEY=
# TRAINING_API_KEY=
# INFER_API_KEY=
# MODEL_GATEWAY_API_KEY=
# EMBEDDING_API_KEY=
# CODE_ENRICHMENT_API_KEY=
# CODE_ENRICHMENT_ALLOWED_REPO_ROOTS=
# PROFILE_EVALUATOR_API_KEY=
# PROFILE_EVALUATOR_ENABLE_LOOP=true
# PROFILE_EVALUATOR_INTERVAL_SEC=300
# PROFILE_PROBE_URLS=http://web:8000
# TRAINING_ARTIFACT_SIGNING_KEY=
# TRAINING_DATASETS_DIR=
# API_KEYS=
# WEBHOOK_SECRETS=github=<random-secret>
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Example .env file for QdrantIngestor
# Copy to .env and fill in your API keys.
# These are read by docker-compose.yml and the application.

# OpenAI API key (for openai_compatible provider)
# OPENAI_API_KEY=sk-your-key-here

# Anthropic API key (for claude provider)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API key (for gemini provider)
# GEMINI_API_KEY=AI-your-key-here

# OpenRouter API key (for openrouter provider; model slugs like openai/gpt-4o-mini)
# OPENROUTER_API_KEY=sk-or-your-key-here

# Qdrant API key (for Qdrant Cloud)
# QDRANT_QDRANT__API_KEY=your-qdrant-key

# Firecrawl API key (enables page scraping during web search; snippets only without it)
# FIRECRAWL_API_KEY=fc-your-key-here

# MISP (Feeds page). Local misp-docker should join the Black Onyx network as
# alias misp; the Feeds form URL is then http://misp (container port 80, not 127.0.0.1).
# Other instances must be public HTTPS. Store the auth key here; the form alone
# does not persist it. Comma-separated extra Docker hostnames are optional.
# MISP_API_KEY=
# BLACK_ONYX_MISP_INTERNAL_HOSTS=misp

# SearXNG session secret. Required for any non-local deployment.
# Generate with: openssl rand -hex 32
# SEARXNG_SECRET=replace-with-random-hex

# Shared service key for authenticated synchronous detection processor calls.
# PROCESSOR_API_KEY=replace-with-random-secret

# ── Security tooling (model-tools integration) ─────────────────────────────
# Required when using docker-compose.security-tools.yml overlay.
# SECURITY_GATEWAY_KEY=     # 32+ character signing key shared by BFF and security-gateway
# SECURITY_RUNNER_TOKEN=    # bearer key shared by security-gateway and runner
# SECURITY_SANDBOX_IMAGE=   # repository@sha256:<published toolbox image digest>
# SECURITY_GUARD_IMAGE=     # repository@sha256:<published firewall helper digest>
# SECURITY_EGRESS_NETWORK=blackonyx_sandbox_egress
# SECURITY_EGRESS_VERIFIED=false # keep false until independent executor escape tests pass
# SECURITY_CAPTURE_VERIFIED=false # separate independent capture isolation gate
# SECURITY_LAB_PROFILES_JSON=    # operator-owned id -> network/CIDR/TCP-port registry
# SECURITY_DEFAULT_LAB_PROFILE=anvil  # lab profile used by security-agent private targets
#
# Optional llama.cpp / Black Onyx 5B serving (security-tools and host overlays).
# LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# BLACK_ONYX_5B_DIR=./models/Black-Onyx-5B
# BLACK_ONYX_5B_FILE=Black-Onyx-5B-Q8_0.gguf
# BLACK_ONYX_5B_MMPROJ=Black-Onyx-5B-mmproj.gguf
# LLM_MODEL_NAME=Black-Onyx-5B:Q8_0
# LLAMA_CTX=131072
# LLAMA_N_GPU_LAYERS=99
#
# Optional overlays when deps already run on the host / another Docker network:
#   docker compose -f docker-compose.yml -f docker-compose.external.yml up -d
#   docker compose -f docker-compose.yml -f docker-compose.platform.yml \
#     -f docker-compose.security-tools.yml -f docker-compose.host.yml up -d
# INTELLIGENCE_NETWORK_NAME=black-onyx_intelligence-network
# If Docker fails with "failed to discover GPU vendor from CDI", clear GPUs:
#   docker compose -f docker-compose.yml -f docker-compose.no-gpu.yml up -d web
#   (docker-compose.external.yml also clears web.gpus for external-Qdrant hosts)
# HOST_QDRANT_UPSTREAM=black-onyx-qdrant
# HOST_POSTGRES_FORWARD=172.30.0.1:5432
# ANTARES_HF_HUB_DIR=           # path to Hugging Face hub models--fdtn-ai--antares-1b
# ANTARES_MODEL_SNAPSHOT=10417eb35641b32e7141157db19c76eb545193b6
# QDRANT_SECURITY__EXTERNAL_URL=http://localhost:8000
# QDRANT_SECURITY__ALLOWED_HOSTS=localhost,127.0.0.1
# BLACK_ONYX_BFF_INTERNAL_URL=http://web:8000
# SHODAN_API_KEY=                # provider key stays in security-gateway only
# SECURITY_CHALLENGE_PROVIDERS_JSON= # optional fixed challenge ID -> endpoint and exact IPv4 allowlist
# SECURITY_SESSIONS_HOST_ROOT=  # absolute host path shared with the Docker daemon (bootstrap sets <repo>/.security-sessions)
# SECURITY_DOCKER_SOCKET_GID=0 # Docker Desktop uses 0; set host socket GID on Linux

# LLM backends.
# Main LLM: llama.cpp serving Black-Onyx-5B Q8_0 GGUF (port 8081 internal).
# LLM_BASE_URL=http://llama-server:8081
# LLM_MODEL_NAME=Black-Onyx-5B:Q8_0
# LLM_TIMEOUT=300
# MAX_TOKENS=4096
# TEMPERATURE=0.7

# Antares-1B: vLLM serving antares-1b safetensors for code-enrichment-worker.
# ANTARES_ENDPOINT=http://vllm-antares:8000/v1
# ANTARES_MODEL=antares-1b

# Optional FunctionGemma tool router (enable with --profile tool-router).
# TOOL_ROUTER_ENABLED=false
# TOOL_ROUTER_BASE_URL=http://tool-router:8080
# TOOL_ROUTER_MODEL=functiongemma-270m-it

# Per-tool gates (default false all destructive/network tools stay off).
# ENABLE_BASH_TOOL=false
# ENABLE_HYDRA=false
# ENABLE_TCPDUMP=false
# ENABLE_CAST_SEND=false
# SQLMAP_EXPLOIT_MODE=false

# Target policy mirrors sandbox SSRF validation.
# ALLOW_PRIVATE_TARGETS=false
# ALLOW_PUBLIC_TARGETS=false
# ALLOWED_TARGETS=

# Approval policy: required (default) or auto (trusted labs only).
# TOOL_APPROVAL=required

# Platform Postgres (auth + tip schemas). Required: web and the security
# gateway refuse to start without their database URLs. Bootstrap generates both.
# BLACK_ONYX_DATABASE_URL=postgresql+psycopg://anomaly:<postgres-password>@postgres:5432/black_onyx
# SECURITY_GATEWAY_DATABASE_URL=postgresql+psycopg://anomaly:<postgres-password>@postgres:5432/security_gateway

# Remote agent binds (Tailscale or other non-loopback). Loopback stays the default.
# INGEST_GATEWAY_HOST_PORT=18090
# INGEST_GATEWAY_REMOTE_BIND=127.0.0.1
# INGEST_GATEWAY_REMOTE_PORT=18091
# ASSET_REGISTRY_HOST_PORT=18081
# ASSET_REGISTRY_REMOTE_BIND=127.0.0.1
# ASSET_REGISTRY_REMOTE_PORT=18082

# Malware lab: CAPE_URL points at a real CAPEv2 lab (CAPE_TOKEN = its REST API
# token). Without it dynamic detonation is disabled (orchestrator not ready).
# CAPE_URL=
# DRAKVUF_URL=
# CAPE_TOKEN=
# DRAKVUF_TOKEN=

# Bundled MISP and self-monitoring overlays.
# MISP_DB_PASSWORD=
# MISP_DB_ROOT_PASSWORD=
# MISP_ADMIN_EMAIL=admin@localhost
# MISP_ADMIN_PASSPHRASE=
# MISP_HOST_PORT=8088
# SELF_MONITOR_TENANT_ID=default
# SELF_MONITOR_HEARTBEAT=true

# Host Wazuh (scripts/install_wazuh_host.sh). Agent install steps are in
# Assets and Detections (GET /api/v1/collectors/guide).
# WAZUH_API_URL=https://127.0.0.1:55000
# WAZUH_API_USER=wazuh
# WAZUH_API_PASSWORD=

# First launch: bash scripts/bootstrap_full_stack.sh
# (Windows: powershell -File scripts/bootstrap_full_stack.ps1)
