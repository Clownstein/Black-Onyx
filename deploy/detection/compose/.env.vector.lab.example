# Lab-only: enable detection vector + federated hunt against shared Qdrant.
# Usage (from repo root / deploy compose stack):
#   copy this beside your compose .env or merge keys, then:
#   docker compose -f docker-compose.yml -f docker-compose.platform.yml \
#     -f deploy/detection/compose/docker-compose.apps.yml --profile vector up -d
#
# Host Qdrant (this machine uses QDRANT_HTTP_PORT=16333):
#   QDRANT_URL=http://host.docker.internal:16333
# In-compose Qdrant service:
#   QDRANT_URL=http://qdrant:6333

QDRANT_URL=http://qdrant:6333
VECTOR_SEARCH_ENABLED=true
FEDERATED_HUNT_ENABLED=true
VECTOR_NOVELTY_ENABLED=true
