# /etc/black-onyx-shipper/shipper.env (mode 0640, root:black-onyx-shipper). Keep secrets out of source control.

# Which local files to ship: wazuh, suricata, osquery (comma-separated).
# Host collectors from installer/* use SHIPPER_SOURCES=osquery only.
SHIPPER_SOURCES=wazuh,suricata

# Detection plane (ingestion-gateway).
BLACK_ONYX_COLLECTOR_TENANT_ID=default
BLACK_ONYX_COLLECTOR_GATEWAY_URL=https://ingest.blackonyx.example.com
BLACK_ONYX_COLLECTOR_INGEST_KEY=replace-with-gateway-ingest-key
BLACK_ONYX_COLLECTOR_ID=shipper-wazuh-01

# TIP connector push (Administration -> Detections -> add a Wazuh connector,
# then Issue push token). Set SHIPPER_WAZUH_PUSH=false when the
# custom-blackonyx integratord hook pushes instead.
BLACK_ONYX_URL=https://blackonyx.example.com
BLACK_ONYX_CONNECTOR_ID=replace-with-connector-id
BLACK_ONYX_CONNECTOR_TOKEN=replace-with-push-token
SHIPPER_WAZUH_PUSH=true
WAZUH_MIN_LEVEL=7
WAZUH_ALERTS_FILE=/var/ossec/logs/alerts/alerts.json

# Suricata sensor identity (required when SHIPPER_SOURCES includes suricata).
SURICATA_EVE_FILE=/var/log/suricata/eve.json
BLACK_ONYX_COLLECTOR_ASSET_ID=sensor-edge-01
BLACK_ONYX_COLLECTOR_SENSOR_ID=sensor-edge-01

# osquery host collector (required when SHIPPER_SOURCES includes osquery).
# BLACK_ONYX_COLLECTOR_ASSET_ID above is reused as the enrolled host id.
OSQUERY_RESULTS_FILE=/var/log/osquery/osqueryd.results.log
BLACK_ONYX_COLLECTOR_HOSTNAME=host-01
BLACK_ONYX_COLLECTOR_OS_FAMILY=linux

# Optional: enroll Wazuh agents and the sensor in asset-registry so the
# host-state heartbeat raises telemetry-gap incidents for silent hosts.
ASSET_REGISTRY_URL=
ASSET_REGISTRY_SERVICE_KEY=
BLACK_ONYX_COLLECTOR_ENVIRONMENT=production
BLACK_ONYX_COLLECTOR_ASSET_CRITICALITY=0.5

# Recommended: list active agents from the Wazuh server API for heartbeats.
# Without it, heartbeats cover only agents that produced alerts since the last
# beat, so a quiet but healthy agent can raise a false telemetry-gap incident.
# Example: WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_CA_FILE=
WAZUH_API_INSECURE=false

# Optional tuning.
SHIPPER_CA_FILE=
SHIPPER_HEARTBEAT_SECONDS=300
SHIPPER_FLUSH_SECONDS=5
SHIPPER_START_AT=end
SHIPPER_STATE_FILE=/var/lib/black-onyx-shipper/state.json
SHIPPER_LOG_LEVEL=INFO
# Must not exceed the ingestion-gateway's MAX_BATCH_SIZE / MAX_BODY_BYTES.
SHIPPER_GATEWAY_BATCH=100
SHIPPER_GATEWAY_MAX_BYTES=900000
# Where rotated files land, so unread lines are drained after rotation.
SHIPPER_WAZUH_ROTATED_GLOB=/var/ossec/logs/alerts/*/*/ossec-alerts-*.json
SHIPPER_SURICATA_ROTATED_GLOB=/var/log/suricata/eve.json.[0-9]*
# The sensor heartbeat is withheld when eve.json is older than this.
SHIPPER_SENSOR_STALE_SECONDS=600
