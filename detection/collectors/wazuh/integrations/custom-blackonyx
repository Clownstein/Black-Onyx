#!/bin/sh
# Wazuh integratord entry point; runs custom-blackonyx.py with Wazuh's bundled Python.
WAZUH_PATH="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON_BIN="${WAZUH_PATH}/framework/python/bin/python3"
[ -x "$PYTHON_BIN" ] || PYTHON_BIN="$(command -v python3)"
exec "$PYTHON_BIN" "$(dirname "$0")/custom-blackonyx.py" "$@"
