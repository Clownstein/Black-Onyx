        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (topic) (clamp_min(delta(anomaly_kafka_topic_high_watermark{topic=~\".*\\\\.dlq\"}[5m]), 0))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "DLQ growth (records / 5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
