# Example secrets for hardened Compose install.
# Copy to `.env` next to compose files or export in the shell.
# Never commit real secrets.

# Required for any non-lab path (demo keys refused unless true)
ALLOW_DEMO_KEYS=false

# Datastores
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
OPENSEARCH_INITIAL_ADMIN_PASSWORD=AnomalyOS#Admin1
MINIO_ROOT_USER=anomaly-minio
MINIO_ROOT_PASSWORD=change-me-minio

# Service keys (must NOT start with dev-/demo- when ALLOW_DEMO_KEYS=false)
API_KEYS=replace-ingest-key
INCIDENT_API_SERVICE_KEY=replace-incident-key
ASSET_REGISTRY_SERVICE_KEY=replace-asset-key
THREAT_INTEL_SERVICE_API_KEY=replace-ti-key
INTEGRATION_HUB_API_KEY=replace-integration-key
RESPONSE_ORCHESTRATOR_API_KEY=replace-response-key
MALWARE_SERVICE_API_KEY=replace-malware-key
NOTIFICATION_WEBHOOK_SECRET=replace-webhook-secret
RESPONSE_ORCHESTRATOR_APPROVER_API_KEY=replace-approver-key
TRAINING_ARTIFACT_SIGNING_KEY=replace-signing-key
GRAFANA_ADMIN_PASSWORD=replace-grafana-password

# Optional external malware-analysis capabilities. Leave URLs blank to expose
# an honest disabled capability state without outbound publication.
CAPE_URL=
CAPE_TOKEN=
DRAKVUF_URL=
DRAKVUF_TOKEN=
MISP_MALWARE_WEBHOOK_URL=
MISP_API_KEY=
OPENCTI_MALWARE_WEBHOOK_URL=
OPENCTI_TOKEN=

# Lab only — set ALLOW_DEMO_KEYS=true and keep short-lived demo values.
