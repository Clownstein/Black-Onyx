# Sample env for Node.js OTLP/HTTP exporters pointed at the Black Onyx collector.

OTEL_SERVICE_NAME=example-node-app
OTEL_SERVICE_NAMESPACE=black-onyx-detection
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=black-onyx-detection
