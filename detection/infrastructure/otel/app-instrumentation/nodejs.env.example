# Sample env for Node.js OTLP/HTTP exporters pointed at AutoAnalyzer's collector.

OTEL_SERVICE_NAME=example-node-app
OTEL_SERVICE_NAMESPACE=anomaly-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=anomaly-platform
