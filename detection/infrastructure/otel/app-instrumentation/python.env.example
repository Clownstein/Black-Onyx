# Copy beside a Python service process (or export in compose) when sending OTLP to the
# optional collector overlay (docker-compose.otel.yml).
#
# Host processes → localhost; containers on the compose network → otel-collector.

OTEL_SERVICE_NAMESPACE=anomaly-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# In-compose apps:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional console spans when no collector is running:
# OTEL_TRACES_CONSOLE=true

# Resource attributes (also set via OTEL_RESOURCE_ATTRIBUTES)
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
